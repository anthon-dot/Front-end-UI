# Supabase Project Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Edge Functions Gateway
VITE_API_URL=https://your-project.supabase.co/functions/v1

# Google Maps API Key
VITE_GOOGLE_MAPS_API_KEY=

# Nodemailer SMTP Configuration (Stakeholder Email Notifications)
# Supports Gmail, Brevo, Outlook, Mailtrap, or any custom municipal SMTP server.
# If left blank during local development, an automated Ethereal test inbox is used.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM="Office of the Market Supervisor <noreply@manticao-market.gov.ph>"

# Optional: Dedicated Node Email Server URL (defaults to /api/email/send via Vite dev plugin)
# VITE_EMAIL_API_URL=http://localhost:3001/api/email/send

