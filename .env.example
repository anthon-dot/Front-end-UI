# Supabase Project Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Edge Functions Gateway
VITE_API_URL=https://your-project.supabase.co/functions/v1

# Google Maps API Key
VITE_GOOGLE_MAPS_API_KEY=

# Automated Stakeholder Email Dispatcher
# Option 1 (Recommended): Resend API (Free 3,000 emails/mo, zero Google App Password needed)
# Sign up at https://resend.com and copy API key
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM="Office of the Market Supervisor <onboarding@resend.dev>"

# Option 2: Brevo API (Free 300 emails/day, zero Google App Password needed)
BREVO_API_KEY=your_brevo_api_key_here
BREVO_FROM="notifications@manticao-market.gov.ph"

# Option 3: Standard SMTP Relay (Optional fallback)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM="Office of the Market Supervisor <noreply@manticao-market.gov.ph>"

# Optional: Dedicated Node Email Server URL (defaults to /api/email/send via Vite dev plugin)
# VITE_EMAIL_API_URL=http://localhost:3001/api/email/send

