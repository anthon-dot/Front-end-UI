# Node.js Express Backend Configuration
PORT=5000
VITE_BACKEND_URL=http://localhost:5000/api
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
JWT_SECRET=your-jwt-secret-at-least-32-chars

# Supabase Server & Client Configuration (@supabase/server)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# Google Maps API Key
VITE_GOOGLE_MAPS_API_KEY=

# ==============================================================================
# NODEMAILER REAL EMAIL DISPATCH CONFIGURATION (FOR LOCAL & VERCEL)
# NOTE: In Vercel, set these in Project Settings -> Environment Variables.
# ==============================================================================

# OPTION 1: Direct Google Workspace (Requires 16-character Google App Password)
# If your university account has 2-Step Verification enabled, generate password at:
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=anthony.jamaca@msunaawan.edu.ph
SMTP_PASS=your-16-char-app-password
SMTP_FROM="Office of the Market Supervisor <anthony.jamaca@msunaawan.edu.ph>"

# OPTION 2: Free SMTP Relay (ZERO 2-Step Verification Required on Google)
# If you CANNOT or DO NOT WANT 2-Step Verification on anthony.jamaca@msunaawan.edu.ph,
# use a free SMTP relay (e.g. Brevo SMTP: smtp-relay.brevo.com).
# Nodemailer still displays anthony.jamaca@msunaawan.edu.ph as the official sender!
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-relay-account-login
# SMTP_PASS=your-relay-smtp-key
# SMTP_FROM="Office of the Market Supervisor <anthony.jamaca@msunaawan.edu.ph>"


